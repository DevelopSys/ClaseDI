<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Text?>


<BorderPane fx:controller="org.example.tiendaapp.controller.UserController" maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <center>
        <TableView fx:id="tableViewProducts" prefHeight="200.0" prefWidth="200.0" tableMenuButtonVisible="true"
                   BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colId" prefWidth="75.0" text="ID"/>
                <TableColumn fx:id="colName" prefWidth="75.0" text="NOMBRE"/>
                <TableColumn fx:id="colPrice" prefWidth="75.0" text="PRECIO"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <BorderPane.margin>
                <Insets bottom="20.0" right="20.0" top="20.0"/>
            </BorderPane.margin>
        </TableView>
    </center>
    <right>
        <GridPane BorderPane.alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Button fx:id="btnComp" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Comprar"/>
                <Button fx:id="btnVac" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Vaciar"
                        GridPane.rowIndex="1"/>
                <Button fx:id="btnCarr" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Ver carrito"
                        GridPane.rowIndex="2"/>
                <Button fx:id="btnLog" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="LOG OUT"
                        GridPane.rowIndex="4"/>
                <Text fx:id="txtTot" strokeType="OUTSIDE" strokeWidth="0.0" text="Total: 0" GridPane.rowIndex="3"/>
            </children>
        </GridPane>
    </right>
    <top>
        <TextField fx:id="editFiltrar" alignment="CENTER" promptText="introduce nombre a buscar"
                   BorderPane.alignment="CENTER"/>
    </top>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
</BorderPane>
