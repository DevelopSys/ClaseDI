<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>


<BorderPane fx:controller="org.example.examen1evdi.controller.HelloController" maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <ImageView fx:id="imagen" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true"
                   BorderPane.alignment="CENTER"/>
    </top>
    <center>
        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
            <children>
                <ComboBox fx:id="comboCategoria" maxWidth="1.7976931348623157E308" prefWidth="150.0"/>
                <Text fx:id="textoChiste" strokeType="OUTSIDE" strokeWidth="0.0"/>
            </children>
        </VBox>
    </center>
    <bottom>
        <FlowPane alignment="CENTER" hgap="20.0" maxWidth="1.7976931348623157E308" prefWidth="200.0"
                  BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="btnChiste" mnemonicParsing="false" text="Generar"/>
                <Button fx:id="btnCategoria" mnemonicParsing="false" text="Categoria"/>
                <Button fx:id="btnFav" mnemonicParsing="false" text="FAV"/>
                <Button fx:id="btnFavList" mnemonicParsing="false" text="Ver favs"/>
            </children>
        </FlowPane>
    </bottom>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
</BorderPane>
